# Copy to .dev.vars for local Wrangler development. Never commit real values.
# Hosted ChatGPT Sites deployments set these as server-side secrets.

# Google OAuth (docs/google.md)
# 32 random bytes, Base64 or Base64url. Keep stable across deployments:
# replacing it makes stored refresh tokens unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOOGLE_TOKEN_KEY=
# Must end in /api/google/callback and match the Google Cloud OAuth client exactly.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/google/callback
# Optional deployment-wide default OAuth client. Owners can also save their own in Connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional paid AI sampling (OpenAI Responses API with web search).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Scheduled writer. Enable only behind a verified owner-private access boundary.
PRIVATE_SITE_JOBS=disabled
# Source mappings refreshed per workspace per scheduled pass (1-25, default 5).
SYNC_BATCH_LIMIT=5
