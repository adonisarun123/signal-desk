# Copy to .env.local for `npm run dev`. On Vercel set these under Project → Settings →
# Environment Variables. Never commit real values.

# Neon Postgres (pooled connection string, ends in -pooler...?sslmode=require)
DATABASE_URL=

# --- Sign-in (server/auth.js) ---
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Google accounts allowed to open the workspace, comma-separated. Empty = nobody.
ALLOWED_EMAILS=
# Google OAuth web client used for sign-in. Authorized redirect URI:
#   https://<your-domain>/api/auth/callback   (and http://localhost:3000/api/auth/callback locally)
# Falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET when unset.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public origin, so preview deployments still use the production redirect URI.
AUTH_URL=http://localhost:3000
# Keep a workspace id from the old ChatGPT Sites deployment: "you@example.com=<old owner id>".
# Needed after importing old data, because stored Google tokens are encrypted against it.
OWNER_ID_OVERRIDES=

# --- Google reporting data (docs/google.md) ---
# 32 random bytes, Base64 or Base64url. Keep stable across deployments (and reuse the old
# deployment's value when importing its data): replacing it makes stored refresh tokens unreadable.
GOOGLE_TOKEN_KEY=
# Must end in /api/google/callback and match the Google Cloud OAuth client exactly.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Optional deployment-wide default OAuth client. Owners can also save their own in Connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional paid AI sampling (OpenAI Responses API with web search) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Scheduled check (Vercel Cron, hourly; see vercel.json) ---
# 16+ random characters. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# Unset = the scheduled check is disabled.
CRON_SECRET=
# Source mappings refreshed per workspace per scheduled pass (1-25, default 5).
SYNC_BATCH_LIMIT=5
